# Copy this file to `.env` and edit it. The backend reloads it on restart.

# Option 1: use a cookies file (Netscape format), e.g. exported by the
# "Get cookies.txt LOCALLY" Chrome extension. You must be logged into the site
# (TikTok, X, etc.) when exporting.
# COOKIES_FILE=cookies.txt

# Option 2: read cookies from an installed browser (chrome, edge, firefox, opera).
# The browser should be closed or it may fail to read the database.
# COOKIES_BROWSER=edge